# qoltanba — example environment configuration.
#
# Every setting has three surfaces derived from one registry entry: a flag
# (--log-level), an env var (QOLTANBA_LOG_LEVEL) and a config-file key (log.level).
# Precedence (low → high): defaults < config file < env < flags.
# Secrets are read only from env or a *_FILE side-file, never from flags.
#
# Copy to .env and adjust. Inspect the resolved config with:
#   qoltanba config-dump
#
# ── Native library (BYOL: you supply the Kalkan library; it is never bundled) ──
QOLTANBA_LIB_PATH=/opt/kalkan/libkalkancryptwr-64.so
#QOLTANBA_LIB_VERSION=            # override version detection (else from file name)
#QOLTANBA_LIB_ISOLATED=false      # isolate pool instances (dlmopen; Linux, workers>1)
#QOLTANBA_LIB_ISOLATION_DEPS=     # comma-separated namespace deps for isolation

# ── Workers / mode ──
QOLTANBA_WORKERS=1                 # max parallel crypto ops; >1 requires LIB_ISOLATED=true
#QOLTANBA_VERIFY_ONLY=false        # disable the key path and sign endpoints entirely

# ── Signed verification receipts and QR-carried documents ──
# Receipts: the service attests to its own verification outcome with the RS256
# service key (same key as OIDC tokens, published at /jwks.json), so a consumer can
# file the attestation and check it later. Signed QR: a short statement — a permit,
# a certificate — that a checkpoint verifies by scanning, needing only the public
# key, which is what makes it work with no connectivity.
#QOLTANBA_RECEIPTS_ENABLED=false
#QOLTANBA_RECEIPTS_ISSUER=                # empty falls back to oidc.issuer
#QOLTANBA_SIGNED_QR_ENABLED=false         # /qr/documents

# ── Try-it console and sandbox ──
# Evaluation aids, both off by default. The sandbox signs with a key nobody
# supplied per request — point it only at a test container: anyone who can reach
# /sandbox/sign can sign arbitrary bytes with it.
#QOLTANBA_CONSOLE_ENABLED=false
#QOLTANBA_CONSOLE_SANDBOX_KEY=                # demo .p12; empty disables /sandbox/sign
#QOLTANBA_CONSOLE_SANDBOX_KEY_PASSWORD=

# ── Tamper-evident audit journal ──
# Hash-chained, signed record of what the service signed and verified. Entries name
# digests and signer identities, never document content. Rewriting history requires
# the service key — and an exported copy still contradicts the attempt.
#QOLTANBA_AUDIT_ENABLED=false
#QOLTANBA_AUDIT_PATH=/var/lib/qoltanba/audit.jsonl
#QOLTANBA_AUDIT_SYNC=false                    # fsync per entry: safer on crash, slower
#QOLTANBA_AUDIT_EXPOSE=false                  # serve /audit/verify and /audit/export

# ── Multi-signature sessions ──
# "Waiting for the accountant": a document tracked until everyone required has
# signed. The service never signs — participants co-sign where their key is and
# submit the container. Rounds run for days, so use the bolt store in production.
#QOLTANBA_MULTISIGN_ENABLED=false
#QOLTANBA_MULTISIGN_TTL=168h                  # 7 days
#QOLTANBA_MULTISIGN_STORE=memory              # memory | bolt
#QOLTANBA_MULTISIGN_BOLT_PATH=/var/lib/qoltanba/multisign.db

# ── Verification portal ──
# Human page at /verify/portal: upload a signature, see who signed. Verification
# needs no key, so this is safe to offer people — but it accepts uploads from
# anyone who can reach it, so publishing it is a deliberate decision.
#QOLTANBA_PORTAL_ENABLED=false

# ── Certificate watch (revocation / upcoming expiry) ──
# Answers the question nobody asks until a signature fails at 3am: is a service key
# about to expire, or already revoked? Exports per-certificate gauges and can post
# a webhook when the situation changes.
#QOLTANBA_CERTWATCH_ENABLED=false
#QOLTANBA_CERTWATCH_DIR=/etc/qoltanba/watch    # .pem/.cer/.crt/.der, one cert per file
#QOLTANBA_CERTWATCH_INTERVAL=6h
#QOLTANBA_CERTWATCH_WARN_FROM=720h             # 30 days ahead
#QOLTANBA_CERTWATCH_WEBHOOK_URL=               # empty = metrics only
#QOLTANBA_CERTWATCH_CHECK_REVOCATION=true      # off = expiry watching only (no outbound OCSP)

# ── Crypto in child processes ──
# The Kalkan library leaks native memory on every operation (~1 MB per CMS verify)
# and corrupts its global state on a revoked OCSP verdict, aborting a later call.
# Neither can be undone in-process, so the service keeps no library of its own:
# crypto runs in children that are recycled on an operation/memory budget and
# respawned after a crash. Leave it on unless you are diagnosing the library.
#QOLTANBA_CRYPTO_WORKER_ENABLED=true
#QOLTANBA_CRYPTO_WORKER_PROCESSES=0       # concurrent crypto children (0 = WORKERS)
#QOLTANBA_CRYPTO_WORKER_TIMEOUT=60s       # per-operation ceiling; bounds a hung native call
#QOLTANBA_CRYPTO_WORKER_MAX_OPS=1000      # retire a child after this many operations (negative disables)
#QOLTANBA_CRYPTO_WORKER_MAX_RSS_MB=512    # retire a child at this resident size (negative disables)
#QOLTANBA_CRYPTO_WORKER_STANDBY=1         # pre-warmed spares; they hide the library load on a recycle (0 = on demand)
#QOLTANBA_CRYPTO_WORKER_KEEP_AFTER_REVOKED=false  # diagnostics only

# ── REST transport ──
QOLTANBA_HTTP_ENABLED=true
QOLTANBA_HTTP_ADDR=:8080           # ":port" for TCP, or "unix:/run/kalkan.sock"

# ── gRPC transport ──
#QOLTANBA_GRPC_ENABLED=false
#QOLTANBA_GRPC_ADDR=:9091          # ":port" for TCP, or "unix:/run/kalkan-grpc.sock"

# ── RabbitMQ transport (enabled by setting the URL) ──
#QOLTANBA_AMQP_URL=amqp://guest:guest@localhost:5672/   # secret; queue provisioned by you
#QOLTANBA_AMQP_QUEUE=kalkan.requests                    # request queue to consume
#QOLTANBA_AMQP_REPLY_QUEUE=                             # fixed reply queue (empty → per-message reply-to)
#QOLTANBA_AMQP_PREFETCH=0                               # QoS prefetch (0 → worker count)

# ── Kafka transport (enabled by setting brokers) ──
#QOLTANBA_KAFKA_BROKERS=localhost:9092                  # comma-separated seed brokers
#QOLTANBA_KAFKA_TOPIC=kalkan.requests                   # request topic
#QOLTANBA_KAFKA_REPLY_TOPIC=kalkan.replies              # default reply topic (reply-topic header overrides)
#QOLTANBA_KAFKA_GROUP=qoltanba                    # consumer group id

# ── NATS JetStream transport (enabled by setting the URL) ──
#QOLTANBA_NATS_URL=nats://localhost:4222                # secret; stream provisioned by you
#QOLTANBA_NATS_SUBJECT=kalkan.requests                  # request subject
#QOLTANBA_NATS_QUEUE=                                   # queue group for load balancing (optional)
#QOLTANBA_NATS_REPLY_SUBJECT=                           # fallback reply subject (empty → per-message reply-to)
#QOLTANBA_NATS_DURABLE=qoltanba                   # durable consumer name

# ── Chain building ──
#QOLTANBA_TRUST_FETCH_AIA=false       # download missing issuers via AIA (CA Issuers URL, incl. .p7c)
#QOLTANBA_TRUST_AIA_TIMEOUT=5         # AIA/registry fetch timeout, seconds
#QOLTANBA_TRUST_USE_RK_REGISTRY=false # preload anchors from the official RK CA registry
#QOLTANBA_TRUST_RK_INCLUDE_TEST=false # include RK test roots when preloading
#QOLTANBA_TRUST_VERIFY_CHAIN=false    # cryptographically validate the signer chain via Kalkan (incl. GOST)
#QOLTANBA_TRUST_REFRESH_INTERVAL=     # background anchor-refresh cadence (e.g. 24h); empty=auto (24h with RK registry), 0/off=disabled
#QOLTANBA_TRUST_CRL_CACHE=false       # cache CRLs by distribution point for Method=CRL validation without inline CRL
#QOLTANBA_TRUST_OCSP_CACHE=false          # reuse recent OCSP answers (spares pki.gov.kz, staples the raw response)
#QOLTANBA_TRUST_OCSP_CACHE_TTL=10m        # bound for an answer without nextUpdate
#QOLTANBA_TRUST_OCSP_CACHE_MAX_ENTRIES=0  # 0 = default 4096
#QOLTANBA_TRUST_TSA_POLICIES=             # TSA policy OIDs accepted for CAdES-T (comma-separated,
                                          # e.g. 1.2.398.3.3.2.6.4 for GOST-2015 only); empty enforces none

# ── Keys / trust ──
#QOLTANBA_KEYS_ALLOW_INLINE=false  # accept inline PKCS#12 in requests (TLS/local only)
#QOLTANBA_SIGN_DEFAULT_TIMESTAMP=false # add a TSA timestamp by default (request may override per call)
#QOLTANBA_TRUST_CA_DIR=/etc/qoltanba/ca   # dir of trusted CA PEM files

# ── Observability ──
QOLTANBA_LOG_LEVEL=info            # debug|info|warn|error
QOLTANBA_LOG_FORMAT=text           # text|json (json for ELK/Loki)
#QOLTANBA_METRICS_ENABLED=false   # expose health/status + Prometheus /metrics on a separate port (also works in gRPC/MQ-only mode)
#QOLTANBA_METRICS_ADDR=:9090      # separate observability port; /metrics is also served on the work port when HTTP is enabled

# ── Secrets via side-files (Docker/K8s secrets, systemd LoadCredential) ──
# For any QOLTANBA_<KEY>, a QOLTANBA_<KEY>_FILE points at a file whose contents
# become the value. Example (illustrative — inline key passwords arrive per
# request, not via config):
#QOLTANBA_SOME_SECRET_FILE=/run/secrets/some_secret

# ── eGov Mobile QR signing/authorization (REST /qr/*) ──
#QOLTANBA_QR_ENABLED=false            # enable the QR orchestrator endpoints
#QOLTANBA_QR_PUBLIC_BASE_URL=         # external base URL for app-facing QR links (behind a proxy); empty uses X-Forwarded-*/Host
#QOLTANBA_QR_DEFAULT_PROFILE=agnostic # agnostic | egov | relay (overridable per request)
#QOLTANBA_QR_DEFAULT_MODE=sign        # sign (return signature) | auth (issue OIDC tokens; requires oidc.enabled)
#QOLTANBA_QR_SESSION_TTL=5m           # session validity window (Go duration)
#QOLTANBA_QR_STORE=memory             # memory | bolt
#QOLTANBA_QR_BOLT_PATH=               # bbolt path (required when qr.store=bolt)
#QOLTANBA_QR_REQUIRE_OCSP=false       # require a good OCSP status before accepting a signature
#QOLTANBA_QR_RELAY_URL=               # upstream gateway base for the relay profile (e.g. https://sigex.kz)
#QOLTANBA_QR_RELAY_ID=                # optional upstream org id path segment
#QOLTANBA_QR_ORGANIZATION=            # organization name shown in eGov Mobile (egov/relay)

# ── Config file (optional; env/flags still override it) ──
#QOLTANBA_CONFIG=/etc/qoltanba/config.yaml
