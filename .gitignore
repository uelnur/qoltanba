# === Проприетарная библиотека Kalkan и секреты (BYOL — НИКОГДА не коммитить) ===
# Права на Kalkan у НУЦ РК / АО «НИТ»; см. .claude/docs/kalkan-api/ и DESIGN §8/§13.
*.so
*.so.*
*.dll
*.dylib
*.a
*.lib
# Ключевой материал / секреты
*.p12
*.pfx
*.key
*.jks
# Локальный конфиг с секретами/окружением (пример — .env.example — коммитим)
.env
/deploy/secrets/

# Локальная папка нативных библиотек и тестовых ключей (BYOL).
# Оставляем только README — сама раскладка и бинарники не в репозитории.
/native/**
!/native/
!/native/README.md

# Полный SDK НУЦ РК (проприетарный) — не в репозитории
/SDK*/
/SDK*.7z
/Документация SDK НУЦ РК/

# Вспомогательная дебаг-песочница (BFF + фронт + локальный compose) — код не
# в репозитории; её durable-план — в .claude/docs/features/dev-playground/.
/playground/

# === Go ===
/qoltanba/**/*.test
*.out
# Binaries `go build ./tools/...` drops in the repo root.
/openapigen
/oidgen
/probe

# Runtime lock of the agent's scheduled tasks — machine state, not source.
/.claude/scheduled_tasks.lock

# === ОС / IDE ===
.DS_Store
.idea/
*.swp

# Generated API clients (tools/sdk/generate.sh) — built on demand, never committed.
/dist/

# Composer artifacts of the shipped Laravel package.
sdk/laravel/vendor/
sdk/laravel/composer.lock
