{
  "info": {
    "name": "qoltanba REST API",
    "description": "Generated from the Go types (tools/openapigen). Set {{baseUrl}} and the base64/secret variables. All keys are lowerCamelCase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Signature",
      "item": [
        {
          "name": "Sign data (CMS / XML / WSSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"format\":\"cms\",\"data\":\"{{dataBase64}}\",\"key\":{\"path\":{\"path\":\"/keys/signer.p12\",\"password\":\"{{keyPassword}}\"}},\"detached\":false,\"withTimestamp\":false}"
            },
            "url": {
              "raw": "{{baseUrl}}/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sign"
              ]
            }
          }
        },
        {
          "name": "Co-sign — add a signer to an already-signed container",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"format\":\"cms\",\"data\":\"{{dataBase64}}\",\"key\":{\"path\":{\"path\":\"/keys/signer2.p12\",\"password\":\"{{keyPassword}}\"}},\"existingSignature\":\"{{signatureBase64}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/sign/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sign",
                "add"
              ]
            }
          }
        },
        {
          "name": "Verify a signature and extract everything available",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"format\":\"cms\",\"signature\":\"{{signatureBase64}}\",\"checkCertTime\":true,\"extractContent\":true,\"claims\":true,\"explain\":true}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify"
              ]
            }
          }
        },
        {
          "name": "Historical (point-in-time) verify: was the signature valid at a past instant, reconstructing certificate validity and revocation status as of that time",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"format\":\"cms\",\"signature\":\"{{signatureBase64}}\",\"at\":\"2022-06-01T00:00:00Z\",\"method\":\"ocsp\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify/at",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "at"
              ]
            }
          }
        },
        {
          "name": "Recover the original content from an attached signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"format\":\"cms\",\"signature\":\"{{signatureBase64}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/extract",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "extract"
              ]
            }
          }
        },
        {
          "name": "Embed long-term validation evidence (CAdES-LT) into an existing signature, so it stays verifiable after the certificate expires",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"signature\":\"{{signatureBase64}}\",\"outputPem\":false}"
            },
            "url": {
              "raw": "{{baseUrl}}/sign/archive",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sign",
                "archive"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Certificate",
      "item": [
        {
          "name": "Fully parse a certificate (optionally build/validate the chain, add claims)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cert\":\"{{certBase64}}\",\"encoding\":\"der\",\"buildChain\":true,\"claims\":true}"
            },
            "url": {
              "raw": "{{baseUrl}}/cert/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cert",
                "info"
              ]
            }
          }
        },
        {
          "name": "Check a certificate's revocation status (OCSP / CRL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cert\":\"{{certBase64}}\",\"encoding\":\"der\",\"method\":\"ocsp\",\"wantOcsp\":true}"
            },
            "url": {
              "raw": "{{baseUrl}}/cert/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cert",
                "validate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Batch",
      "item": [
        {
          "name": "Sign many items (aggregated JSON, or NDJSON stream with Accept: application/x-ndjson)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"format\":\"cms\",\"data\":\"{{dataBase64}}\",\"key\":{\"path\":{\"path\":\"/keys/signer.p12\",\"password\":\"{{keyPassword}}\"}}}],\"policy\":\"continue-on-error\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/sign/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sign",
                "batch"
              ]
            }
          }
        },
        {
          "name": "Verify many signatures",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"format\":\"cms\",\"signature\":\"{{signatureBase64}}\"}],\"policy\":\"continue-on-error\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "batch"
              ]
            }
          }
        },
        {
          "name": "Recover content from many attached signatures",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"format\":\"cms\",\"signature\":\"{{signatureBase64}}\"}]}"
            },
            "url": {
              "raw": "{{baseUrl}}/extract/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "extract",
                "batch"
              ]
            }
          }
        },
        {
          "name": "Parse many certificates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"cert\":\"{{certBase64}}\",\"encoding\":\"der\"}]}"
            },
            "url": {
              "raw": "{{baseUrl}}/cert/info/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cert",
                "info",
                "batch"
              ]
            }
          }
        },
        {
          "name": "Check revocation for many certificates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"cert\":\"{{certBase64}}\",\"encoding\":\"der\",\"method\":\"ocsp\"}]}"
            },
            "url": {
              "raw": "{{baseUrl}}/cert/validate/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cert",
                "validate",
                "batch"
              ]
            }
          }
        },
        {
          "name": "Verify a set of documents and return the auditor's register: counts plus one row per document with its verdict, signers and first failing check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"ref\":\"contract-2024-11.p7s\",\"format\":\"cms\",\"signature\":\"{{signatureBase64}}\"}],\"policy\":\"continue-on-error\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify/registry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "registry"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Challenge",
      "item": [
        {
          "name": "Issue a single-use nonce bound to a purpose (the anti-replay handshake as a standalone primitive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"purpose\":\"payment.approve\",\"meta\":{\"orderId\":\"1042\"}}"
            },
            "url": {
              "raw": "{{baseUrl}}/challenge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challenge"
              ]
            }
          }
        },
        {
          "name": "Confirm a challenge with the user's detached signature and report who signed it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"challengeId\":\"{{challengeId}}\",\"signature\":\"{{signatureBase64}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/challenge/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challenge",
                "confirm"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Signed-qr",
      "item": [
        {
          "name": "Issue a QR carrying a short statement signed with the service key (verifiable offline, no ЭЦП needed to check it)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"subject\":\"{{iin}}\",\"data\":{\"permit\":\"A-142\"},\"ttlSeconds\":86400}"
            },
            "url": {
              "raw": "{{baseUrl}}/qr/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "qr",
                "documents"
              ]
            }
          }
        },
        {
          "name": "Check a scanned document QR against the service key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"payload\":\"{{qrPayload}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/qr/documents/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "qr",
                "documents",
                "verify"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sandbox",
      "item": [
        {
          "name": "Sign with the operator's demo key, so the service can be evaluated without an ЭЦП of one's own (off unless a sandbox key is configured)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"data\":\"{{dataBase64}}\",\"format\":\"cms\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/sandbox/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sandbox",
                "sign"
              ]
            }
          }
        },
        {
          "name": "Built-in test console: pick an operation, edit the body, see the raw response (off by default)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/console",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "console"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Oidc",
      "item": [
        {
          "name": "OpenID Connect discovery document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/.well-known/openid-configuration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "openid-configuration"
              ]
            }
          }
        },
        {
          "name": "JSON Web Key Set for token verification",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/oidc/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "jwks.json"
              ]
            }
          }
        },
        {
          "name": "Issue a challenge nonce to sign with ЭЦП",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nonce\":\"{{rpNonce}}\",\"state\":\"{{rpState}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/oidc/challenge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "challenge"
              ]
            }
          }
        },
        {
          "name": "Verify the signed challenge and issue OIDC tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"challengeId\":\"{{challengeId}}\",\"signature\":\"{{signatureBase64}}\",\"clientId\":\"{{clientId}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/oidc/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "verify"
              ]
            }
          }
        },
        {
          "name": "Claims for a bearer access token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/oidc/userinfo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "userinfo"
              ]
            }
          }
        },
        {
          "name": "Public keys the service signs with — verification receipts, signed-document QR and OIDC tokens (served even when OIDC is off)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jwks.json"
              ]
            }
          }
        },
        {
          "name": "Authorization endpoint: renders the hosted login page that collects a signature (authorization code + PKCE)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/oidc/authorize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "authorize"
              ]
            }
          }
        },
        {
          "name": "Submit the collected signature and redirect back to the relying party with an authorization code",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/oidc/authorize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "authorize"
              ]
            }
          }
        },
        {
          "name": "Token endpoint: exchange an authorization code for tokens (client credentials in the body or HTTP Basic)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/oidc/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oidc",
                "token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Qr",
      "item": [
        {
          "name": "Start an eGov Mobile QR signing/auth session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"mode\":\"sign\",\"profile\":\"agnostic\",\"data\":\"{{dataBase64}}\",\"callbackUrl\":\"{{callbackUrl}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/qr/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "qr",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Poll a QR session for the verified result or tokens",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/qr/sessions/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "qr",
                "sessions",
                "{id}"
              ]
            }
          }
        },
        {
          "name": "App-facing: eGov Mobile fetches the data-to-sign",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/qr/a/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "qr",
                "a",
                "{id}"
              ]
            }
          }
        },
        {
          "name": "App-facing: eGov Mobile returns the signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"signature\":\"{{signatureBase64}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/qr/a/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "qr",
                "a",
                "{id}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Multisign",
      "item": [
        {
          "name": "Open a session for a document that needs several signatures",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"format\":\"cms\",\"document\":\"{{dataBase64}}\",\"required\":[{\"iin\":\"{{iin}}\",\"label\":\"Директор\"},{\"role\":\"CEO\"}],\"subject\":\"Договор №42\",\"ttlSeconds\":604800}"
            },
            "url": {
              "raw": "{{baseUrl}}/multisign/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "multisign",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Session state: who has signed, who is still owed, and the container as it stands",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/multisign/sessions/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "multisign",
                "sessions",
                "{id}"
              ]
            }
          }
        },
        {
          "name": "Submit the container after a participant co-signed it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"container\":\"{{signatureBase64}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/multisign/sessions/{id}/signatures",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "multisign",
                "sessions",
                "{id}",
                "signatures"
              ]
            }
          }
        },
        {
          "name": "Cancel a session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/multisign/sessions/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "multisign",
                "sessions",
                "{id}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "Walk the journal's hash chain and report whether — and where — it was altered",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/audit/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit",
                "verify"
              ]
            }
          }
        },
        {
          "name": "Stream the journal as NDJSON for a SIEM (supports range requests and conditional fetches)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/audit/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit",
                "export"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Portal",
      "item": [
        {
          "name": "Upload form for checking a signature (off by default — it accepts uploads from anyone who can reach it)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/verify/portal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "portal"
              ]
            }
          }
        },
        {
          "name": "Check an uploaded container and render the verification card",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/verify/portal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify",
                "portal"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Observability",
      "item": [
        {
          "name": "Liveness — the process is up",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        },
        {
          "name": "Readiness — library loaded and self-tested",
